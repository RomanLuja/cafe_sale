      <column caption='Best by total-spent' datatype='string' name='[Calculation_0739212770508800]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([total_spent]) = WINDOW_MAX(SUM([total_spent])) THEN &quot;Best&quot; ELSE &quot;Other&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Best by quantity' datatype='string' name='[Calculation_0739212777689089]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([quantity]) = WINDOW_MAX(SUM([quantity])) THEN &quot;Best&quot; ELSE &quot;Other&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='count_transaactions' datatype='integer' name='[Calculation_0739213757640708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([transaction_id])' />
      </column>
      <column caption='outlier' datatype='string' name='[Calculation_0739213821837323]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [total_spent] &lt; -8 OR [total_spent] &gt; 24 THEN &quot;Outlier&quot; ELSE &quot;Normal&quot; END' />
      </column>
      <column caption='Corr Qty-Total' datatype='real' name='[Calculation_0739213837717516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CORR([quantity], [total_spent])' />
      </column>
      <column caption='Corr Price-Total' datatype='real' name='[Calculation_0739213839405069]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CORR([price_per_unit],[total_spent])' />
      </column>
      <column caption='Corr Qty-Price' datatype='real' name='[Calculation_0739213839896590]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CORR([quantity],[price_per_unit])' />
      </column>

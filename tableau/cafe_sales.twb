    <worksheet name='Outliers (Boxplot)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Outliers analysis</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='9'>Outliers analysis:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='9'> Based on the IQR rule (</run>
            <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='9'>$Q1 = 4.0$</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='9'>, </run>
            <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='9'>$Q3 = 12.0$</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='9'>, </run>
            <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='9'>$IQR = 8.0$</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='9'>), the normal range for </run>
            <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='9'>total_spent</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='9'> is up to $24.0. All 259 outliers are valid transactions (5 Salads at $5.0 = $25.0), so they are retained to preserve accurate revenue.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cafe_sales_clean' name='federated.1a5mxq71atri0p1d2ntdw0epe546' />
          </datasources>
          <datasource-dependencies datasource='federated.1a5mxq71atri0p1d2ntdw0epe546'>
            <column caption='outlier' datatype='string' name='[Calculation_0739213821837323]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [total_spent] &lt; -8 OR [total_spent] &gt; 24 THEN &quot;Outlier&quot; ELSE &quot;Normal&quot; END' />
            </column>
            <column-instance column='[Calculation_0739213821837323]' derivation='None' name='[none:Calculation_0739213821837323:nk]' pivot='key' type='nominal' />
            <column-instance column='[transaction_date]' derivation='None' name='[none:transaction_date:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[quantity]' role='measure' type='quantitative' />
            <column-instance column='[quantity]' derivation='Sum' name='[sum:quantity:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_spent]' derivation='Sum' name='[sum:total_spent:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[total_spent]' role='measure' type='quantitative' />
            <column datatype='date' name='[transaction_date]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1a5mxq71atri0p1d2ntdw0epe546].[none:transaction_date:qk]' filter-group='4' included-values='in-range'>
            <min>#2023-01-01#</min>

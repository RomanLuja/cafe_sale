            <format attr='height' field='[federated.1a5mxq71atri0p1d2ntdw0epe546].[sum:quantity:qk]' value='51' />
            <format attr='height' field='[federated.1a5mxq71atri0p1d2ntdw0epe546].[sum:total_spent:qk]' value='51' />

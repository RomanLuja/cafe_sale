    <worksheet name='Daily revenue'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Daily revenue</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='9'>Daily revenue exhibits significant fluctuations throughout the year; however, the 7-day moving average effectively smooths out these peaks, revealing a stable underlying trend within the $2,500–$2,900 range.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cafe_sales_clean' name='federated.1a5mxq71atri0p1d2ntdw0epe546' />
          </datasources>
          <datasource-dependencies datasource='federated.1a5mxq71atri0p1d2ntdw0epe546'>
            <column-instance column='[transaction_date]' derivation='Day' name='[dy:transaction_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[transaction_date]' derivation='Day' name='[dy:transaction_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[transaction_date]' derivation='None' name='[none:transaction_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_spent]' derivation='Sum' name='[sum:total_spent:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[total_spent]' role='measure' type='quantitative' />
            <column datatype='date' name='[transaction_date]' role='dimension' type='ordinal' />
